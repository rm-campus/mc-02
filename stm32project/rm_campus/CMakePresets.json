{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "SERVO_STATUS_ONLY": "ON"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "RobotControl",
            "inherits": "Debug",
            "cacheVariables": {
                "ROBOT_CONTROL_PROFILE": "ON",
                "SERVO_STATUS_ONLY": "OFF"
            }
        },
        {
            "name": "RobotControlTelemetry",
            "inherits": "RobotControl",
            "cacheVariables": {
                "ROBOT_SERVO_TELEMETRY": "ON"
            }
        },
        {
            "name": "RobotControlFashionStar",
            "inherits": "RobotControlTelemetry",
            "cacheVariables": {
                "ROBOT_FASHIONSTAR_GRIPPER": "ON"
            }
        },
        {
            "name": "ServoId",
            "inherits": "Release",
            "cacheVariables": {
                "SERVO_ID_SETUP": "ON",
                "SERVO_STATUS_ONLY": "OFF"
            }
        },
        {
            "name": "ServoMixedProbe",
            "inherits": "ServoId",
            "cacheVariables": {
                "SERVO_MIXED_PROBE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "RobotControl",
            "configurePreset": "RobotControl"
        },
        {
            "name": "RobotControlTelemetry",
            "configurePreset": "RobotControlTelemetry"
        },
        {
            "name": "RobotControlFashionStar",
            "configurePreset": "RobotControlFashionStar"
        },
        {
            "name": "ServoId",
            "configurePreset": "ServoId"
        },
        {
            "name": "ServoMixedProbe",
            "configurePreset": "ServoMixedProbe"
        }
    ]
}
